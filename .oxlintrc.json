{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["old-routes/**", ".tmp-codex/**", "build/**", "storybook-static/**"],
  "jsPlugins": ["@shadcn/lint"],
  "plugins": ["react", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "complexity": ["warn", { "max": 10, "variant": "classic" }],
    "max-depth": ["warn", { "max": 4 }],
    "react/rules-of-hooks": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "react-router",
            "importNames": ["Link", "NavLink", "Form", "Navigate", "useNavigate", "useSubmit", "useSearchParams"],
            "allowTypeImports": true,
            "message": "Use the adapters in app/navigation/ so local client navigation has view transitions by default. See docs/navigation.md."
          }
        ]
      }
    ],
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"]
      }
    ]
  },
  "settings": {
    "shadcn": {
      "componentImports": ["^~/components/primitive(?:/|$)"],
      "note": "Use or update a primitive instead of overriding its visual contract. See AGENTS.md#primitive-first-ui."
    }
  },
  "overrides": [
    {
      "files": ["app/navigation/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["app/components/primitive/**", "app/components/ui/**"],
      "rules": {
        "shadcn/no-restyle": "off"
      }
    }
  ],
  "env": {
    "builtin": true
  }
}
